# Optional: copy to .env to override defaults. Everything works without it.

# Host ports (uncommon range to avoid clashes). CORS/Sanctum settings derive from these.
FRONTEND_PORT=47173
BACKEND_PORT=47180
DB_PORT=47432
MAILPIT_UI_PORT=47125

# Laravel app key. Leave empty in dev: the container generates one at startup
# (you'll just be logged out of admin on restart). Set a real key in any shared env.
APP_KEY=

# Postgres (local container only)
DB_DATABASE=catalogue
DB_USERNAME=catalogue
DB_PASSWORD=catalogue

# Seeded admin login for curating featured products. Local development only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Email: enquiries are sent to this inbox (caught by Mailpit locally).
SALES_INBOX_ADDRESS=sales@example.com
MAIL_FROM_ADDRESS=catalogue@example.com

# Product data source
CATALOGUE_PROVIDER=fakestore   # name from config/catalogue.php 'providers'; unknown falls back to fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
